{
 "_version": "menu-1.7 (2026-10-12)",
 "_note": "서버에서 내려주는 메뉴 설정. 순서·노출·라벨·배지는 이 파일만 바꿔서 조정해요. 값 자체(포인트, 확률 등)는 economy.json / starter.json / 유저 상태 API에서 읽어요.",
 "panel": {
  "side": "right",
  "widthPt": 312,
  "openMs": 280,
  "closeMs": 220,
  "easingOpen": "cubic-bezier(.22,1,.36,1)",
  "easingClose": "cubic-bezier(.4,0,1,1)",
  "dimOpacity": 0.58,
  "swipeToCloseThresholdPt": 80
 },
 "header": {
  "title": "MENU.",
  "subtitle": "오늘도 고양이랑 천천히 놀아요",
  "stats": [
   {
    "id": "paw",
    "label": "내 포인트",
    "value": "user.pawBalance",
    "format": "number(ko-KR)",
    "icon": "icon-paw-mini.svg"
   },
   {
    "id": "nyangCoin",
    "label": "냥코인",
    "value": "user.nyangCoinBalance",
    "format": "number(ko-KR)",
    "icon": "/assets/ncoin/ncoin-16@3x.svg"
   },
   {
    "id": "dex",
    "label": "도감",
    "value": "user.dexOwned",
    "total": "dex.totalCards",
    "showProgressBar": true,
    "tapTo": "dex"
   },
   {
    "id": "roomLv",
    "label": "방 레벨",
    "value": "user.cozyLevel",
    "format": "'Lv.'+value",
    "source": "economy.json → cozy.levels",
    "tapTo": "room"
   }
  ]
 },
 "sections": [
  {
   "id": "daily",
   "label": "DAILY",
   "rows": [
    "attendance",
    "points",
    "exchange",
    "ticketShop",
    "rewards"
   ]
  },
  {
   "id": "more",
   "label": "MORE",
   "rows": [
    "rates",
    "notice",
    "invite",
    "settings"
   ]
  }
 ],
 "rows": {
  "attendance": {
   "label": "출석 체크",
   "icon": "icon-attendance.svg",
   "enabled": true,
   "open": "sheet:attendance",
   "meta": "'{n}일째 · 선물 도착' if canClaimToday else '누적 {attendanceDays}일 · 내일 또 만나요'",
   "data": "starter.json → attendance (firstWeek / weeklyCycle / milestones)",
   "badge": {
    "type": "dot",
    "when": "attendance.canClaimToday"
   }
  },
  "points": {
   "label": "포인트 받기",
   "icon": "icon-points.svg",
   "enabled": true,
   "open": "action:rewardedAd(paw)",
   "meta": "'남은 횟수 {remaining}/{economy.pawSources.rewardedAd.maxPerDay}'",
   "data": "economy.json → pawSources.rewardedAd (pawPerAd 10, maxPerDay 10), events.weekendDoublePaw",
   "badge": {
    "type": "pill",
    "text": "주말 2배",
    "when": "events.weekendDoublePaw.enabled && today in events.weekendDoublePaw.days"
   },
   "disabledWhen": "remaining == 0",
   "disabledMeta": "내일 다시 열려요",
   "adTag": {
    "text": "광고",
    "style": "cream-border (main-draw-pill-ad)"
   }
  },
  "exchange": {
   "label": "중복 카드 교환",
   "icon": "icon-exchange.svg",
   "enabled": true,
   "open": "sheet:exchange",
   "meta": "'중복 {user.duplicateCount}장'",
   "data": "economy.json → pawSources.duplicateConvert",
   "badge": {
    "type": "none"
   },
   "disabledWhen": "user.duplicateCount == 0",
   "disabledMeta": "아직 겹친 카드가 없어요"
  },
  "ticketShop": {
   "label": "뽑기권",
   "icon": "icon-ticket.svg",
   "enabled": true,
   "open": "sheet:ticketShop",
   "meta": "'보유 {rateUpTickets}장 · 오늘 {dayBought}/{dayLimit}'",
   "data": "economy.json → shop.tickets.rateUpTicket + tickets.rateUpTicket.maxHold",
   "badge": {
    "type": "none"
   }
  },
  "rewards": {
   "label": "보상함",
   "icon": "icon-rewards.svg",
   "enabled": true,
   "open": "sheet:rewards",
   "meta": "'🪙{nyangCoinBalance} 냥코인 · 도감 보상 {rewards.dexClaimableCount}'",
   "data": "economy.json → dexRewards.claimMode=manual + pawSources.newCardFirstGet / setComplete",
   "badge": {
    "type": "dot",
    "when": "rewards.dexClaimableCount > 0"
   }
  },
  "rates": {
   "label": "확률 안내",
   "icon": "icon-rates.svg",
   "enabled": true,
   "open": "sheet:rates",
   "meta": "5성↑·스페셜 {sum(b5,special,character,legend)}%",
   "data": "economy.json → draws.rates_proposal.normal / rateUp / keys",
   "badge": {
    "type": "none"
   },
   "required": true,
   "_note": "확률 공개는 필수 — enabled=false로 내리지 마세요"
  },
  "notice": {
   "label": "공지·이벤트",
   "icon": "icon-notice.svg",
   "enabled": true,
   "open": "sheet:notice",
   "meta": "최신 이벤트 제목 pill (예: 주말 포인트 2배)",
   "data": "/notices API + economy.json → events",
   "badge": {
    "type": "pill-new",
    "text": "NEW",
    "when": "latestNotice.id > user.lastSeenNoticeId"
   }
  },
  "invite": {
   "label": "친구 초대",
   "icon": "icon-invite.svg",
   "enabled": false,
   "open": "sheet:invite",
   "disabledPill": "준비 중",
   "data": "economy.json → events.friendInvite (enabled=false)",
   "enableWhen": "economy.events.friendInvite.enabled == true"
  },
  "settings": {
   "label": "설정",
   "icon": "icon-settings.svg",
   "enabled": true,
   "open": "page:settings",
   "items": [
    {
     "id": "bgm",
     "label": "배경음악(BGM)",
     "type": "toggle",
     "default": false,
     "storage": "lc.audio.bgm"
    },
    {
     "id": "sfx",
     "label": "효과음",
     "type": "toggle",
     "default": true,
     "storage": "lc.audio.sfx"
    },
    {
     "id": "haptic",
     "label": "진동",
     "type": "toggle",
     "default": true,
     "storage": "local"
    },
    {
     "id": "reduceMotion",
     "label": "움직임 줄이기",
     "type": "toggle",
     "default": "prefers-reduced-motion",
     "storage": "local"
    },
    {
     "id": "replayTutorial",
     "label": "튜토리얼 다시 보기",
     "type": "action",
     "action": "tutorial.replay",
     "data": "tutorial.json (보상 재지급 없음)"
    },
    {
     "id": "contact",
     "label": "문의하기",
     "type": "link",
     "url": "TODO"
    },
    {
     "id": "terms",
     "label": "이용약관",
     "type": "link",
     "url": "TODO"
    },
    {
     "id": "privacy",
     "label": "개인정보처리방침",
     "type": "link",
     "url": "TODO"
    },
    {
     "id": "credits",
     "label": "오디오 크레딧",
     "type": "link",
     "url": "/assets/audio/LICENSES.md"
    },
    {
     "id": "version",
     "label": "버전",
     "type": "text",
     "value": "app.version"
    }
   ]
  }
 },
 "menuIconBadge": {
  "type": "dot",
  "on": "#btn-menu (메인 우상단 발바닥)",
  "when": "any(row.badge.type=='dot' && row.badge.when)"
 },
