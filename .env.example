# Supabase Edge Functions (game-save, wallet).
# Leave either value empty to skip server calls. Do not commit real keys.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Wallet mode. Omit this line to follow economy.json nyangCoin.walletMode (default server).
# server: the phone only sends requests; the server decides balance, amounts, and limits.
# local: practice grants on this device, with no server wallet calls and no real payout.
# VITE_WALLET_MODE=local
