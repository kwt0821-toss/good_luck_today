{
 "_version": "tutorial-1.4",
 "maxDurationSec": 60,
 "style": "coach marks (dim + 하이라이트 원/라운드 사각 + 말풍선)",
 "skip": {
  "button": {
   "id": "tut-skip",
   "label": "건너뛰기",
   "position": "top-right below app bar; if target in top 160pt or overlaps skip, use bubble footer text button"
  },
  "onSkip": "남은 단계 보상은 그대로 지급 (첫 뽑기 무료·도감 등록은 서버에서 처리, 도감 보상은 도감에서 직접 수령), tutorialDone=true; contextual rewards-intro skip → tut.rewardsIntro=skipped",
  "resume": "앱 종료 시 다음 실행 때 현재 단계부터, 2회 이상 중단 시 자동 완료"
 },
 "steps": [
  {
   "step": 1,
   "screen": "main",
   "target": "#stage-cat",
   "copy": "톡, 깨워 볼까요?",
   "sub": "첫 뽑기는 광고 없이 무료예요",
   "action": "tap",
   "reward": "free first draw (no ad)"
  },
  {
   "step": 2,
   "screen": "draw-reveal",
   "target": "#reveal-card",
   "copy": "오늘의 행운 문구가 도착했어요",
   "toast": {
    "id": "dex-toast",
    "text": "새 고양이를 만났어요\n도감에서 보상을 받아 보세요",
    "autoHideMs": 2800,
    "holdDuringTutorial": true
   },
   "then": {
    "id": "ncoin-intro",
    "delayAfterToastMs": 600,
    "title": "냥코인을 모아요",
    "lines": [
     {
      "icon": "/assets/ncoin/ncoin-16@3x.svg",
      "text": "새 카드를 뽑으면 냥코인을 받아요"
     },
     {
      "icon": "/assets/menu/icon-dex-mini.svg",
      "text": "도감에서 보상을 직접 받아요"
     },
     {
      "icon": "/assets/menu/icon-rewards.svg",
      "text": "10개부터 토스포인트로 바꿔요"
     },
     {
      "icon": "/assets/menu/icon-paw-mini.svg",
      "text": "발바닥 포인트랑은 달라요",
      "muted": true,
      "dividerAbove": true
     }
    ],
    "cta": "알겠어요",
    "dismissToastWithCta": true,
    "next": {
     "target": "#btn-to-dex",
     "copy": "도감에서 보상을 받아 볼까요?"
    }
   },
   "action": "tap #btn-to-dex (도감에서 보상 받기)"
  },
  {
   "step": 3,
   "screen": "main→dex",
   "target": "#icon-dex",
   "effect": "glow pulse",
   "copy": "도감에서 모은 카드를 볼 수 있어요",
   "then": {
    "screen": "dex",
    "target": "#dex-claim-{cardId}",
    "fallbackTarget": "#dex-slot-{cardId}",
    "copy": "코인을 누르면 보상을 받을 수 있어요"
   },
   "action": "tap"
  },
  {
   "step": 4,
   "screen": "room",
   "target": "#drawer-item-0",
   "copy": "서랍에서 아이템을 꺼내 방에 놓아 보세요",
   "gesture": "drag hint (손가락 애니메이션)",
   "suggestTile": {
    "c": 5,
    "r": 2
   },
   "then": {
    "target": "#room-done",
    "copy": "다 꾸몄으면 완료를 눌러요"
   },
   "action": "drag + tap 완료",
   "complete": "tutorialDone=true"
  }
 ],
 "contextual": {
  "rewards-intro": {
   "id": "rewards-intro",
   "flag": "tut.rewardsIntro",
   "once": true,
   "gate": "tutorialDone && not drawing && not ad && not otherSheet",
   "triggers": [
    {
     "when": "nyangCoinBalance >= 10",
     "from": "r1",
     "note": "냥코인 처음 ≥10 (r1부터)"
    },
    {
     "when": "openSheet:rewards",
     "from": "r3",
     "note": "보상함 처음 열기 (r3부터) — 둘 중 먼저 1회"
    }
   ],
   "lockDismiss": true,
   "steps": [
    {
     "id": "r1",
     "target": "#icon-menu",
     "copy": "메뉴에서 보상함을 열 수 있어요",
     "action": "tap → open menu"
    },
    {
     "id": "r2",
     "target": "#menu-row-rewards",
     "copy": "보상함을 눌러 볼까요?",
     "action": "tap → open sheet:rewards"
    },
    {
     "id": "r3",
     "target": "#wallet-card",
     "copy": "모은 냥코인이 여기에 보여요",
     "action": "next"
    },
    {
     "id": "r4",
     "target": "#withdraw-picker",
     "bubble": "above",
     "copy": "−/+로 금액을 골라요 · 하루 최대 50원까지 받을 수 있어요",
     "lines": [
      {
       "when": "nyangCoinBalance >= 10 && remainingToday >= 10",
       "copy": "−/+로 금액을 골라요 · 하루 최대 50원까지 받을 수 있어요"
      },
      {
       "when": "nyangCoinBalance >= 10 && remainingToday < 10",
       "copy": "오늘은 다 받았어요 · 내일 00:00에 다시 받을 수 있어요"
      },
      {
       "when": "nyangCoinBalance < 10",
       "copy": "10냥코인부터 토스포인트로 받을 수 있어요"
      }
     ],
     "action": "ack — 실제 출금은 유저가 직접"
    }
   ]
  }
 },
 "replay": {
  "from": "settings",
  "includes": [
   "steps 1–4",
   "contextual.rewards-intro from r1"
  ],
  "regrantRewards": false
 },
 "featureIntros": {
  "ui": "'새 기능' 말풍선 (대상 요소 옆, 1회 노출, 탭하면 닫힘)",
  "schedule": [
   {
    "day": 2,
    "id": "intro-extra-draws",
    "target": "#chip-draws",
    "copy": "광고를 보면 하루 2번 더 뽑을 수 있어요"
   },
   {
    "day": 3,
    "id": "intro-rateup",
    "target": "#btn-rateup",
    "copy": "확률업 뽑기가 열렸어요! 레어 이상이 더 잘 나와요"
   },
   {
    "day": 4,
    "id": "intro-paw-ads",
    "target": "#icon-menu",
    "copy": "메뉴 › 포인트 받기에서 광고 보고 포인트 10개 받아요 (하루 10번까지)"
   },
   {
    "day": 5,
    "id": "intro-dup-convert",
    "target": "#dex-dup-convert",
    "copy": "겹친 카드는 포인트로 바꿀 수 있어요",
    "condition": "중복 카드 1장 이상"
   },
   {
    "day": 6,
    "id": "intro-cozy",
    "target": "#cozy-meter",
    "copy": "아이템을 모을수록 아늑함 레벨이 올라가요"
   }
  ],
  "rule": "하루 최대 1개, 조건 미충족 시 다음 날로 밀림, 튜토리얼 미완료면 노출 안 함"
 }
}
