{
 "_version": "menu-1.1 (2026-10-11)",
 "_note": "서버에서 내려주는 메뉴 설정. 순서·노출·라벨·배지는 이 파일만 바꿔서 조정해요. 값 자체(포인트, 확률 등)는 economy.json / starter.json / 유저 상태 API에서 읽어요.",
 "panel": {
  "side": "right",
  "widthPt": 312,
  "openMs": 280,
  "closeMs": 220,
  "easingOpen": "cubic-bezier(.22,1,.36,1)",
  "easingClose": "cubic-bezier(.4,0,1,1)",
  "dimOpacity": 0.58,
  "swipeToCloseThresholdPt": 80
 },
 "header": {
  "title": "MENU.",
  "subtitle": "오늘도 고양이랑 천천히 놀아요",
  "stats": [
   {
    "id": "paw",
    "label": "내 포인트",
    "value": "user.pawBalance",
    "format": "number(ko-KR)",
    "icon": "icon-paw-mini.svg"
   },
   {
    "id": "dex",
    "label": "도감",
    "value": "user.dexOwned",
    "total": "dex.totalCards",
    "showProgressBar": true,
    "tapTo": "dex"
   },
   {
    "id": "roomLv",
    "label": "방 레벨",
    "value": "user.cozyLevel",
    "format": "'Lv.'+value",
    "source": "economy.json → cozy.levels",
    "tapTo": "room"
   }
  ]
 },
 "sections": [
  {
   "id": "daily",
   "label": "DAILY",
   "rows": [
    "attendance",
    "points",
    "exchange",
    "rewards"
   ]
  },
  {
   "id": "more",
   "label": "MORE",
   "rows": [
    "rates",
    "notice",
    "invite",
    "settings"
   ]
  }
 ],
 "rows": {
  "attendance": {
   "label": "출석 체크",
   "icon": "icon-attendance.svg",
   "enabled": true,
   "open": "sheet:attendance",
   "meta": "firstWeek(누적 1~7일): '{attendanceDays+1}일째 · 선물 도착' / 이후: '누적 {attendanceDays}일 · {nextMilestone.days}일까지 {left}일' — 오늘 받았으면 '내일 또 만나요'",
   "data": "starter.json → attendance (firstWeek, weeklyCycle, milestones, noReset), prices.json → attendanceOnly",
   "badge": {
    "type": "dot",
    "when": "attendance.canClaimToday"
   }
  },
  "points": {
   "label": "포인트 받기",
   "icon": "icon-points.svg",
   "enabled": true,
   "open": "action:rewardedAd(paw)",
   "meta": "'남은 횟수 {remaining}/{economy.pawSources.rewardedAd.maxPerDay}'",
   "data": "economy.json → pawSources.rewardedAd (pawPerAd 10, maxPerDay 10), events.weekendDoublePaw",
   "badge": {
    "type": "pill",
    "text": "주말 2배",
    "when": "events.weekendDoublePaw.enabled && today in events.weekendDoublePaw.days"
   },
   "disabledWhen": "remaining == 0",
   "disabledMeta": "내일 다시 열려요"
  },
  "exchange": {
   "label": "중복 카드 교환",
   "icon": "icon-exchange.svg",
   "enabled": true,
   "open": "sheet:exchange",
   "meta": "'중복 {user.duplicateCount}장'",
   "data": "economy.json → pawSources.duplicateConvert",
   "badge": {
    "type": "none"
   },
   "disabledWhen": "user.duplicateCount == 0",
   "disabledMeta": "아직 겹친 카드가 없어요"
  },
  "rewards": {
   "label": "보상함",
   "icon": "icon-rewards.svg",
   "enabled": true,
   "open": "sheet:rewards",
   "meta": "'받을 보상 {rewards.unclaimedCount}'",
   "data": "economy.json → pawSources.newCardFirstGet, setComplete, tossPayout",
   "badge": {
    "type": "dot",
    "when": "rewards.unclaimedCount > 0"
   }
  },
  "rates": {
   "label": "확률 안내",
   "icon": "icon-rates.svg",
   "enabled": true,
   "open": "sheet:rates",
   "meta": "5성↑·스페셜 {sum(b5,special,character,legend)}%",
   "data": "economy.json → draws.rates_proposal.normal / rateUp / keys",
   "badge": {
    "type": "none"
   },
   "required": true,
   "_note": "확률 공개는 필수 — enabled=false로 내리지 마세요"
  },
  "notice": {
   "label": "공지·이벤트",
   "icon": "icon-notice.svg",
   "enabled": true,
   "open": "sheet:notice",
   "meta": "최신 이벤트 제목 pill (예: 주말 포인트 2배)",
   "data": "/notices API + economy.json → events",
   "badge": {
    "type": "pill-new",
    "text": "NEW",
    "when": "latestNotice.id > user.lastSeenNoticeId"
   }
  },
  "invite": {
   "label": "친구 초대",
   "icon": "icon-invite.svg",
   "enabled": false,
   "open": "sheet:invite",
   "disabledPill": "준비 중",
   "data": "economy.json → events.friendInvite (enabled=false)",
   "enableWhen": "economy.events.friendInvite.enabled == true"
  },
  "settings": {
   "label": "설정",
   "icon": "icon-settings.svg",
   "enabled": true,
   "open": "page:settings",
   "items": [
    {
     "id": "sfx",
     "label": "효과음",
     "type": "toggle",
     "default": true,
     "storage": "local"
    },
    {
     "id": "haptic",
     "label": "진동",
     "type": "toggle",
     "default": true,
     "storage": "local"
    },
    {
     "id": "reduceMotion",
     "label": "움직임 줄이기",
     "type": "toggle",
     "default": "prefers-reduced-motion",
     "storage": "local"
    },
    {
     "id": "replayTutorial",
     "label": "튜토리얼 다시 보기",
     "type": "action",
     "action": "tutorial.replay",
     "data": "tutorial.json (보상 재지급 없음)"
    },
    {
     "id": "contact",
     "label": "문의하기",
     "type": "link",
     "url": "TODO"
    },
    {
     "id": "terms",
     "label": "이용약관",
     "type": "link",
     "url": "TODO"
    },
    {
     "id": "privacy",
     "label": "개인정보처리방침",
     "type": "link",
     "url": "TODO"
    },
    {
     "id": "version",
     "label": "버전",
     "type": "text",
     "value": "app.version"
    }
   ]
  }
 },
 "menuIconBadge": {
  "type": "dot",
  "on": "#icon-menu (메인 우상단 발바닥)",
  "when": "any(row.badge.type=='dot' && row.badge.when)"
 },
 "sheets": {
  "attendance": {
   "states": {
    "firstWeek": {
     "when": "attendanceDays < 7 (또는 오늘 7일차 받기 전)",
     "eyebrow": "DAILY GIFT · WEEK 01",
     "title": "출석 체크",
     "titleTag": "출석 한정",
     "desc": "7일 출석하면 {firstWeek[6].nameKo}가 방으로 와요.\n하루 빠져도 괜찮아요, 출석한 날만큼 이어서 받아요.",
     "cells": "firstWeek 7칸 (DAY 7은 2칸, \"출석 한정\" 태그)",
     "cta": "오늘 선물 받기 · {todayItem.nameKo}",
     "note": "출석 선물은 상점에서 팔지 않는 출석 한정 아이템이에요",
     "mock": "menu-screen-b.png"
    },
    "weeklyCycle": {
     "when": "attendanceDays >= 7",
     "eyebrow": "DAILY GIFT",
     "title": "출석 체크",
     "desc": "출석은 누적으로 쌓여요. 하루 빠져도 이어서 받아요.",
     "cumulativeCard": {
      "big": "{attendanceDays}",
      "caption": "DAYS",
      "milestone": "{nextMilestone.titleKo}까지 {nextMilestone.days - attendanceDays}일",
      "sub": "{milestoneItem.nameKo} + 배지 [출석 한정]",
      "badgeImage": "badge-att-{days}.svg",
      "progress": "attendanceDays / nextMilestone.days",
      "afterLast": "모든 기념 보상을 받았으면 카드는 누적 일수만 보여 줘요"
     },
     "weekLabel": "이번 주 출석 · WEEK {cycleNo:02} · DAY {cycleDay}/7",
     "cells": "weeklyCycle.days 1~6 = icon-paw-coin.svg + \"+{paw}P\", DAY 7 = itemBox(icon-att-box.svg \"출석 선물 상자\") 또는 rateUpTicket(icon-ticket.svg \"확률업 뽑기권\") — 다음 주기 보상을 sub로 안내",
     "cta": "오늘 {paw}포인트 받기 | 오늘 선물 상자 열기 | 오늘 뽑기권 받기",
     "note": "7일차 보상은 주마다 선물 상자와 확률업 뽑기권이 번갈아 와요",
     "mock": "menu-screen-b2.png"
    }
   },
   "ctaDone": "오늘 출석 완료! 내일 또 만나요",
   "milestoneToast": "{days}일 출석 기념! {itemNameKo}와 배지를 받았어요",
   "boxAllOwnedToast": "상자를 다 모았어요! 대신 100포인트를 드려요",
   "thumbs": "gift-{itemId}.png (출석 한정 아이템 타일)",
   "note": "받은 아이템은 방꾸미기 서랍에 들어가요"
  },
  "rates": {
   "title": "확률 안내",
   "eyebrow": "DRAW RATES",
   "desc": "뽑기 결과는 서버에서 정해져요.\n같은 등급 안에서는 카드마다 확률이 같아요.",
   "tabs": [
    "일반 뽑기",
    "확률업 뽑기"
   ],
   "rows": [
    [
     "b1",
     "1성",
     18
    ],
    [
     "b2",
     "2성",
     18
    ],
    [
     "b3",
     "3성",
     18
    ],
    [
     "b4",
     "4성",
     18
    ],
    [
     "b5",
     "5성",
     18
    ],
    [
     "special",
     "스페셜",
     9
    ],
    [
     "character",
     "캐릭터",
     4
    ],
    [
     "legend",
     "레전드",
     4
    ]
   ],
   "highlight": [
    "b5",
    "special",
    "character",
    "legend"
   ],
   "perCardDecimals": 3,
   "note": "카드 1장 확률은 소수점 넷째 자리에서 반올림했어요"
  },
  "exchange": {
   "title": "중복 카드 교환",
   "eyebrow": "SWAP",
   "desc": "겹친 카드를 포인트로 바꿔요. 카드는 1장씩 남아요.",
   "cta": "한 번에 바꾸기 · {total}P"
  },
  "rewards": {
   "title": "보상함",
   "eyebrow": "REWARDS",
   "desc": "도감을 채우면 토스 포인트와 발바닥 포인트가 와요.",
   "cta": "모두 받기"
  }
 },
 "attendanceOnlyTag": {
  "text": "출석 한정",
  "style": "pill 8.5px 700, bg #C9B6F2, text #1E1A2B, radius 999, padding 1×6",
  "showIn": [
   "출석 시트",
   "방꾸미기 서랍",
   "상점(목록에는 안 나오지만 보유 아이템 상세)",
   "아이템 상세"
  ],
  "when": "item.attendanceOnly == true"
 }
}